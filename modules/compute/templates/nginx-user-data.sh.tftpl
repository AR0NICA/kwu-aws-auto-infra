#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y nginx

cat > /var/www/html/index.html <<'HTML'
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>KWU AWS Auto Infra</title>
  <style>
    :root { color-scheme: dark; --bg:#050a16; --panel:#0e1930cc; --line:#253b62; --accent:#48c7ff; --text:#eef7ff; --muted:#9db2ca; }
    * { box-sizing:border-box; } body { margin:0; min-height:100vh; display:grid; place-items:center; font-family:Inter,ui-sans-serif,system-ui,sans-serif; background:radial-gradient(circle at 20% 10%,#103a68 0,transparent 32%),radial-gradient(circle at 80% 85%,#34205f 0,transparent 36%),var(--bg); color:var(--text); }
    .card { width:min(680px,92vw); padding:48px; border:1px solid var(--line); border-radius:24px; background:var(--panel); box-shadow:0 24px 90px #0008; backdrop-filter:blur(16px); }
    .eyebrow { color:var(--accent); font-size:.76rem; font-weight:800; letter-spacing:.16em; text-transform:uppercase; } h1 { margin:14px 0 12px; font-size:clamp(2rem,6vw,3.6rem); letter-spacing:-.06em; } p { color:var(--muted); font-size:1.05rem; line-height:1.7; }
    .grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin-top:32px; } .item { padding:16px; border:1px solid var(--line); border-radius:14px; background:#081326; } .label { color:var(--muted); display:block; font-size:.74rem; text-transform:uppercase; letter-spacing:.1em; } .value { display:block; margin-top:8px; color:var(--accent); font-family:ui-monospace,SFMono-Regular,monospace; font-weight:700; }
    a { color:var(--accent); } @media (max-width:560px) { .card{padding:32px 24px}.grid{grid-template-columns:1fr;} }
  </style>
</head>
<body><main class="card"><span class="eyebrow">Edge tier · operational</span><h1>Nginx is working.</h1><p>The public web tier is healthy and ready to proxy application traffic to the private Tomcat tier.</p><div class="grid"><div class="item"><span class="label">Availability Zone</span><span class="value">${zone}</span></div><div class="item"><span class="label">Application route</span><a class="value" href="/app/">/app/</a></div></div></main></body>
</html>
HTML

rm -f /etc/nginx/sites-enabled/default
cat > /etc/nginx/conf.d/tomcat-proxy.conf <<'NGINX'
upstream tomcat_backend {
    least_conn;
%{ for ip in tomcat_private_ips ~}
    server ${ip}:8080 max_fails=3 fail_timeout=10s;
%{ endfor ~}
}

server {
    listen 80 default_server;
    server_name _;
    root /var/www/html;
    index index.html;

    location /app/ {
        proxy_pass http://tomcat_backend/;
        proxy_http_version 1.1;
        proxy_set_header Host $${host};
        proxy_set_header X-Real-IP $${remote_addr};
        proxy_set_header X-Forwarded-For $${proxy_add_x_forwarded_for};
        proxy_set_header X-Forwarded-Proto $${scheme};
    }
}
NGINX

nginx -t
systemctl enable --now nginx
